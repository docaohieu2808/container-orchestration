# Operator build helpers. controller-gen is pinned here and run through `go run`, so nothing is installed globally.
CONTROLLER_GEN_VERSION ?= v0.23.0
CONTROLLER_GEN = go run sigs.k8s.io/controller-tools/cmd/controller-gen@$(CONTROLLER_GEN_VERSION)
CRD_FILE = ../l4-operators-crds/crd-webapp-custom-resource-definition.yaml
IMG ?= webapp-operator:dev

.PHONY: generate manifests build test vet docker-build

# DeepCopy methods for the API types -> api/v1alpha1/zz_generated.deepcopy.go
generate:
	$(CONTROLLER_GEN) object paths=./api/...

# CRD for the API types -> the l4 CRD manifest (the Go types are the source of truth)
manifests:
	{ printf '%s\n' '# L4: CRD — WebApp Custom Resource Definition' \
	    '# GENERATED by controller-gen from kubernetes/l5-custom-controller/api/v1alpha1 (run `make manifests` there).' \
	    '# A CustomResourceDefinition extends the Kubernetes API with a new resource type: once applied,' \
	    '# WebApp objects can be created/listed/deleted like built-in resources. Pattern: group=apps.example.com,' \
	    '# version=v1alpha1, kind=WebApp. The operator in l5 watches and reconciles instances.'; \
	  $(CONTROLLER_GEN) crd paths=./api/... output:crd:stdout; } > $(CRD_FILE)

vet:
	go vet ./...

test:
	go test -race ./...

build:
	go build -o manager .

docker-build:
	docker build -t $(IMG) .
